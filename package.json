  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "companion": "node companion/server.mjs",
    "start:local": "node scripts/start-local.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
